.git
.gitignore
.venv
__pycache__
**/__pycache__/
*.pyc
*.pyo

# Secrets — must never reach the build context or an image layer.
# Provide these via Secret Manager / --set-env-vars instead.
.env
.env.*
!.env.example

# Local SQLite database (contains user records and encrypted integration tokens)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Local-only helpers
scratch/
tests/
.pytest_cache/
