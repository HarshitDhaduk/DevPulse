# ── Required ────────────────────────────────────────────────────────────
# Google Gemini — used for report synthesis and chat
GOOGLE_API_KEY=your_google_api_key_here

# ── Persistent secrets ──────────────────────────────────────────────────
# IMPORTANT: set both of these explicitly in any deployed environment.
# If they are left blank the app generates random values at startup and can
# only persist them when this .env file exists on disk. In a container there
# is no .env, so every restart produces new keys:
#   * JWT_SECRET changes      -> all users are signed out
#   * ENCRYPTION_KEY changes  -> every integration token already stored in
#                                user_settings becomes permanently unreadable
# Generate with:
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   JWT_SECRET:     python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
JWT_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
# Used for the OAuth redirect_uri fallback and added to the CORS allow-list.
FRONTEND_URL=http://localhost:3000

# ── Google Sign-In ──────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend .env.local
GOOGLE_CLIENT_ID=

# ── Integration OAuth apps (optional) ───────────────────────────────────
# Only needed for the one-click "Connect with ..." buttons. Users can always
# paste a personal token in Settings instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=

# ── Optional overrides ──────────────────────────────────────────────────
# Directory holding devpulse.db (set to a mounted volume in production)
# DB_DIR=
# Path to the Coral binary; falls back to PATH, then backend/coral-bin/
# CORAL_BIN=
